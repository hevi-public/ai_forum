@import com.aiforum.web.FeedPage
@import com.aiforum.web.FeedView
@import com.aiforum.web.PersonaView
@import com.aiforum.web.ActiveThreadRow
@import com.aiforum.web.RecentCommentRow
@import com.aiforum.web.StarredCommentRow
@param feed: FeedPage
@param personas: List<PersonaView>
@param activeThreads: List<ActiveThreadRow>
@param recentComments: List<RecentCommentRow>
@param starredComments: List<StarredCommentRow>
@param threadCount: Int
@param personaCount: Int
@param shortcut: com.aiforum.shortcut.ShortcutResult = com.aiforum.shortcut.ShortcutResult.DISABLED

@template.layout(title = "AI Forum", activeNav = "threads", content = @`
    <div class="home" data-page="home">
      <%-- Left rail. The front-page side boxes (design left rail); Members is the first occupant. The
           grid collapses to a single column below the rail breakpoint — see .home:has(.home__rail). --%>
      <aside class="home__rail" data-home-rail>
          @template.fragments.forumNavBox(threadCount = threadCount, personaCount = personaCount)
          @template.fragments.membersBox(personas = personas)
      </aside>
      <%-- data-feed-view sits on the main column, which is rendered whatever the forum holds — so the
           view the page is showing stays assertable on an empty forum, where the toggle is the only way
           back (ambient-slice-6 §2.5). --%>
      <div class="home__main" data-feed-view="${feed.view.slug}">
        @template.fragments.wideToggle()
        <h1 class="home__title">${feed.view.title}</h1>
        @template.fragments.feedToggle(view = feed.view)
        <%-- One view's cards, never both. The two lists are separately typed (D5), so handing a stream
             card to the thread-card fragment is a build failure rather than a review question; and only
             the active view's query was issued, so the other list is empty by construction. The two
             empty states are DIFFERENT — "no threads yet" is not "nothing has happened yet" — which is
             why the key comes off the view itself. --%>
        @if(feed.view == FeedView.THREADS)
            @if(feed.threadCards.isEmpty())
                <div data-empty-state="${feed.view.emptyStateKey}">No threads yet — start one!</div>
            @else
                <div class="thread-index">
                    @for(card in feed.threadCards)
                        @template.fragments.threadCard(card = card)
                    @endfor
                </div>
            @endif
        @else
            @if(feed.events.isEmpty())
                <div data-empty-state="${feed.view.emptyStateKey}">Nothing has happened yet.</div>
            @else
                @template.fragments.activityStream(events = feed.events)
            @endif
        @endif
        <%-- Ask the room: a click-to-reveal new-thread composer in the main column (was a right-rail
             CTA). The <summary> is the design's "Ask the room" card; opening the disclosure reveals
             the full new-thread form below. Built on <details> so the form still posts with JS off —
             the form (form-urlencoded POST to /threads → PRG redirect onto the fresh thread, title +
             optional body = the opening post, §2) is always in the DOM, just visually collapsed.
             Creating the thread auto-summons the room (a "Whole Topic + Anyone" call, §2), so the fresh
             thread page shows the room already drafting its replies. Enter submits the form (Shift+Enter
             = newline; app.js, [data-new-thread]).
             It sits OUTSIDE the view branch — posting is the one thing you can do from either reading —
             and its "start open" test is the forum's thread COUNT rather than "this view rendered no
             cards", which would spring the composer open on an activity view that simply has no thread
             cards to show. On an empty forum there's nothing to browse, so it starts open: the form is
             the one thing a first-time visitor is here to do, no click required. --%>
        <details class="ask-card" id="new-thread" data-ask-room open="${threadCount == 0}">
            <summary class="ask-card__summary">
                <span class="ask-card__title">Ask the room</span>
                <span class="ask-card__lead">Post a question; pick who answers.</span>
                <span class="btn btn--block ask-card__cta" data-ask-room-cta>+ New thread</span>
            </summary>
            <%-- Multipart so the opening post can carry an image (name="images"). The urlencoded + JSON
                 /threads handlers stay for the acceptance suite / API; the browser posts here. --%>
            <form class="new-thread" data-new-thread method="post" action="/threads"
                  enctype="multipart/form-data">
                <input class="new-thread__title" type="text" name="title" required
                       placeholder="Title — what's the thread about?">
                <textarea class="new-thread__body" name="text" rows="3"
                          placeholder="Body — the details of your post (optional)"></textarea>
                <label class="new-thread__attach" data-new-thread-attach>
                    <input type="file" name="images" data-new-thread-images
                           accept="image/png,image/jpeg,image/gif,image/webp" multiple>
                    <span>🖼 Attach image (optional)</span>
                </label>
                <div class="new-thread__actions">
                    <button class="btn" type="submit">Create ▸</button>
                </div>
            </form>
        </details>
      </div>
      <%-- Right rail. The design's right-hand side boxes; Active threads is the first occupant. Drops
           below the main column on narrow screens — see .home:has(.home__rail-right). --%>
      <aside class="home__rail-right" data-home-rail-right>
          @template.fragments.shortcutBox(shortcut = shortcut)
          @template.fragments.starredCommentsBox(starred = starredComments)
          <%-- D11, the owner's call: in the ACTIVITY view the recent-comments box is a strict subset of
               the stream beside it — the same five comments twice on one screen — so it is suppressed
               there and only there. The suppression lives HERE and not in the fragment or in RailFeeds,
               because both are shared byte-for-byte with every thread page, which is the property their
               KDoc exists to protect. --%>
          @if(feed.view == FeedView.THREADS)
              @template.fragments.recentCommentsBox(comments = recentComments)
          @endif
          @template.fragments.activeThreadsBox(threads = activeThreads)
      </aside>
    </div>
`)
