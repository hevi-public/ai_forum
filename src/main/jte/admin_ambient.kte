@import com.aiforum.web.AmbientRunView
@import com.aiforum.web.AuthorLabel
@import com.aiforum.web.UsageAggregatesView
@param runs: List<AmbientRunView>
@param usage: UsageAggregatesView

@template.layout(title = "Admin · Ambient runs · AI Forum", activeNav = "admin", content = @`
    <div class="admin-list" data-admin-list="ambient">
        <p class="admin-list__back"><a href="/admin">← Admin</a></p>
        <h1 class="admin-list__title">Ambient runs</h1>
        <p class="admin-list__lede">Each ambient tick — posted, no-op, or failed — is logged here. Fire one by hand any time (the scheduler kill switch never disables this button).</p>
        <%-- The manual trigger. POSTs to /admin/ambient/tick, which runs one tick and 303-redirects back
             here so the fresh run shows at the top. Ungated: the owner can always hand-fire a tick. --%>
        <form class="admin-ambient__trigger" method="post" action="/admin/ambient/tick" data-ambient-trigger>
            <button class="btn" type="submit">Run a tick now ▸</button>
        </form>
        <%-- The usage strip (issue #16): rolling 24h/7d spend + tool-call counts, computed live off TWO
             DIFFERENT populations — a review-caught false claim on this branch (it used to read as one
             population), now stated precisely (plan_docs/usage-observability.md §3). data-cost-24h/-7d
             come from AmbientRunRepository.costSince, AMBIENT RUNS ONLY (the same rows the run list below
             shows — no separate ledger for those), and follow the run row's own data-cost-usd idiom: JTE
             omits a null-valued attribute, so an all-unpriced window renders NO attribute (never a
             misleading "0.0000"). data-tool-calls-24h/-7d come from
             GenerationToolCallRepository.countSince, which counts EVERY generation_tool_call row with no
             ambient-vs-owner filter (owner summons record traces too — see UsageAggregatesView's KDoc)
             and, being a plain COUNT, is never unknown — it always renders, a real zero included. The
             prose below says "(all generations)" so an operator doesn't inherit the same false
             ambient-only reading the plan doc corrected. --%>
        <section class="admin-ambient__usage" data-usage-aggregates data-cost-24h="${usage.cost24h}" data-cost-7d="${usage.cost7d}" data-tool-calls-24h="${usage.toolCalls24h}" data-tool-calls-7d="${usage.toolCalls7d}">
            <p class="admin-list__meta admin-ambient__usage-line">Last 24h: ${if (usage.cost24h != null) "$" + usage.cost24h else "—"} · ${usage.toolCalls24h} tool calls (all generations) — Last 7d: ${if (usage.cost7d != null) "$" + usage.cost7d else "—"} · ${usage.toolCalls7d} tool calls (all generations) · <a href="/admin/tools" data-tools-link>Tool calls →</a></p>
        </section>
        @if(runs.isEmpty())
            <p class="admin-list__empty" data-admin-list-empty="true">No ambient ticks yet — run one above.</p>
        @else
            <ul class="admin-list__items">
                @for(run in runs)
                    <%-- data-detail mirrors the rendered detail text as a stable, grep-able hook (house
                         convention, like data-outcome/data-action). JTE OMITS an attribute whose ${}
                         value is null, so the hook is present iff run.detail is — the honest RED/absent
                         case the acceptance probe (Html.latestAmbientRunAttr) distinguishes. --%>
                    <%-- data-cost-usd is the same absent-vs-empty idiom one attribute over (issue #15):
                         a run whose generations reported no cost renders NO attribute, because NULL there
                         means UNKNOWN and a "0.0000" would claim the tick was free. Attribute-only for
                         now — the operator-facing readout of spend is issue #16. --%>
                    <li class="admin-list__item" data-ambient-run="${run.id}" data-outcome="${run.outcome}" data-action="${run.action}" data-detail="${run.detail}" data-cost-usd="${run.costUsd}">
                        <span class="admin-list__meta">
                            <span class="admin-list__badge">${run.outcome}</span>
                            <span class="admin-list__sep">·</span>
                            <span class="admin-ambient__source">${run.source}</span>
                            @if(run.articleTitle != null)
                                <span class="admin-list__sep">·</span>
                                @if(run.articleUrl != null)
                                    <span class="admin-ambient__article"><a href="${run.articleUrl}" data-ambient-article>${run.articleTitle}</a></span>
                                @else
                                    <span class="admin-ambient__article">${run.articleTitle}</span>
                                @endif
                            @endif
                            @if(run.personaId != null)
                                <span class="admin-list__sep">·</span>
                                <span class="admin-ambient__persona" data-ambient-persona="${run.personaId}">by ${AuthorLabel.display(run.personaId)}</span>
                            @endif
                            @if(run.threadId != null)
                                <span class="admin-list__sep">·</span>
                                <span class="admin-ambient__thread"><a href="/threads/${run.threadId}" data-ambient-thread="${run.threadId}">view thread</a></span>
                            @endif
                            @if(run.detail != null)
                                <span class="admin-list__sep">·</span>
                                <span class="admin-ambient__detail">${run.detail}</span>
                            @endif
                            <%-- The human-visible half of #15's cost figure (issue #16) — data-cost-usd
                                 above already carries the machine value; this is the same fact rendered
                                 as CHILD TEXT so an operator can actually see it. Rendered only when
                                 priced: an unpriced run shows nothing here (no "—" filler), matching the
                                 attribute's own absent-means-unknown idiom rather than inventing a second
                                 placeholder convention for the same fact. --%>
                            @if(run.costUsd != null)
                                <span class="admin-list__sep">·</span>
                                <span class="admin-list__cost">$${run.costUsd}</span>
                            @endif
                            <span class="admin-list__sep">·</span>
                            <span class="admin-list__ago">${run.ago}</span>
                        </span>
                    </li>
                @endfor
            </ul>
        @endif
    </div>
`)
