@import com.aiforum.web.InterestFieldView
@import com.aiforum.web.PersonaView
@import com.aiforum.web.StanceFieldView
@import com.aiforum.persona.Dials
@param persona: PersonaView
@param dialKeys: List<String>
@param stanceFields: List<StanceFieldView>
@param interestFields: List<InterestFieldView>

@template.layout(title = "Edit " + persona.name + " · AI Forum", activeNav = "members", content = @`
    <div data-page="edit-persona">
        <h1 class="home__title">Edit ${persona.name}</h1>
        <%-- Re-composing edit: the previous values + prompt are replayed to the LLM server-side so it
             ADJUSTS the prompt rather than regenerating it. The name (hence id/slug) is fixed here. --%>
        <form class="new-persona" data-edit-persona data-persona-form method="post" action="/personas/${persona.slug}/edit">
            <textarea class="new-persona__descriptor" name="descriptor"
                      placeholder="Character notes — voice, expertise, point of view (optional)">${persona.descriptor}</textarea>
            <input class="new-persona__abilities" type="text" name="abilities"
                   value="${persona.abilities.joinToString(", ")}"
                   placeholder="Abilities — comma-separated (e.g. kotlin, systems)">
            <%-- Currently into (S4b, plan_docs/ambient-slice-4b.md D11): one field per phrase the member
                 holds, plus one blank to add with. This fieldset IS the member's interest list — a phrase
                 you blank is retracted, and a phrase you type is stamped as YOURS, which the weekly drift
                 pass then skips for good. There is deliberately no unpin control: the documented way back
                 is to blank the field, which deletes the row.
                 Like the stance fields these do NOT flag the prompt stale. An interest is injected at
                 generation time and never enters the composed prompt (D7), so editing one must never gate
                 Save behind a paid Regenerate — which is also why persona-form-core needs no change here:
                 it classifies an unrecognised field name as inert, which is the correct answer. --%>
            <fieldset class="new-persona__interests" data-interests>
                <legend>Currently into</legend>
                @for(field in interestFields)
                    <label class="interest-field">
                        <input type="text" name="${field.name}" data-interest-field="${field.name}"
                               value="${field.value}"
                               placeholder="A short phrase — what this member keeps coming back to">
                        <span class="interest-field__note">${field.note}</span>
                    </label>
                @endfor
            </fieldset>
            <fieldset class="new-persona__dials" data-dials>
                <legend>Dials</legend>
                @for(key in dialKeys)
                    <label class="dial">
                        <span class="dial__label">${Dials.describe(key)}</span>
                        <input type="range" name="dial_${key}" min="0" max="10" value="${persona.dials.getOrDefault(key, Dials.DEFAULT)}">
                    </label>
                @endfor
            </fieldset>
            <%-- Relations (S3): one free-text field per OTHER member — a persona holds no stance about
                 itself. Blank retracts the view. These do NOT flag the prompt stale: a stance is read
                 fresh at reply time, so editing one must never gate Save behind a paid Regenerate
                 (persona-form-core classifies a stance field as inert for exactly this reason). --%>
            @if(!stanceFields.isEmpty())
                <fieldset class="new-persona__relations" data-relations>
                    <legend>Relations</legend>
                    @for(field in stanceFields)
                        <label class="stance-field">
                            <span class="stance-field__label">Toward ${field.toName}</span>
                            <textarea name="stance_${field.toId}" data-stance-field="${field.toId}"
                                      placeholder="How ${persona.name} sees ${field.toName} — free text; blank means no stance">${field.text}</textarea>
                        </label>
                    @endfor
                </fieldset>
            @endif
            <select class="new-persona__model" name="model">
                <option value="" selected="${persona.model.isEmpty()}">default model</option>
                <option value="claude-haiku-4-5-20251001" selected="${persona.model == "claude-haiku-4-5-20251001"}">Haiku 4.5 (fast)</option>
                <option value="claude-sonnet-4-6" selected="${persona.model == "claude-sonnet-4-6"}">Sonnet 4.6</option>
                <option value="claude-opus-4-8" selected="${persona.model == "claude-opus-4-8"}">Opus 4.8</option>
                <option value="claude-fable-5" selected="${persona.model == "claude-fable-5"}">Fable 5</option>
                <%-- A model pinned outside the list above (e.g. a local id set while running the openai
                     provider) must keep an option, or the browser falls back to "default model" and Save
                     silently WIPES the pin. --%>
                @if(persona.model.isNotEmpty() && persona.model !in listOf("claude-haiku-4-5-20251001", "claude-sonnet-4-6", "claude-opus-4-8", "claude-fable-5"))
                    <option value="${persona.model}" selected="${true}">${persona.model} (custom)</option>
                @endif
            </select>
            <%-- Prefilled with the current prompt. "Regenerate" re-composes from the (edited) inputs
                 against the previous values, swapping the result in; Save persists exactly what's shown.
                 Changing an input above flags Regenerate and disables Save until it's re-run (app.js). --%>
            <textarea id="edit-persona-prompt" class="new-persona__prompt" name="systemPrompt" data-prompt-field>${persona.systemPrompt}</textarea>
            <div class="form-actions">
                <a class="btn btn--ghost" data-cancel-edit href="/personas/${persona.slug}">Cancel</a>
                <span class="form-actions__spacer"></span>
                <button type="button" class="btn btn--ghost" data-preview-prompt
                        hx-post="/personas/${persona.slug}/compose" hx-include="closest form"
                        hx-target="#edit-persona-prompt" hx-swap="innerHTML"
                        hx-disabled-elt="this" hx-indicator="next .regen-spinner">
                    Regenerate prompt
                </button>
                <span class="htmx-indicator regen-spinner" aria-live="polite">
                    <span class="spinner" aria-hidden="true"></span>Composing…
                </span>
                <button class="btn" type="submit">Save changes ▸</button>
            </div>
        </form>
    </div>
`)
