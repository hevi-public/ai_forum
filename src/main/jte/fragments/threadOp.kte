@import com.aiforum.dto.AttachmentView
@import com.aiforum.web.AuthorColor
@import com.aiforum.web.AuthorLabel
@import com.aiforum.web.PersonaView
@param threadId: String
@param title: String
@param body: String
@param bodyHtml: String
@param edited: Boolean = false
@param attachments: List<AttachmentView> = java.util.Collections.emptyList()
<%-- author is the OP's attribution (V20): a persona id when the ambient loop authored the thread, null
     when the owner did. personas resolves the persona's avatar hue for the byline monogram. Both default
     so an owner-authored render (every existing caller) stays byline-less. --%>
@param author: String? = null
@param personas: List<PersonaView> = emptyList()

<%-- The opening post block, extracted so the OP edit (§7) can re-render just this region. It is the root
     of the keyboard-nav tree (data-nav-item="post"; k/h/gg land here) and carries the #reply-<threadId>
     permalink. The OP edit form outerHTML-swaps this whole div (hx-target="#reply-<threadId>"), so the
     POST returns exactly this fragment. data-edited mirrors a comment's marker hook. data-thread-author
     is a JTE smart attribute — omitted entirely when author is null (owner-authored), present for a
     persona-authored thread (the acceptance probe reads it), so nothing false-matches. --%>
<div class="thread__op" data-nav-item="post" data-nav-id="${threadId}" id="reply-${threadId}"
     data-edited="${edited.toString()}" data-thread-author="${author}">
    <div class="thread__op-head">
        @if(author != null)
            <%-- Persona byline: the ambient loop opened this thread AS a persona (round-robin, never the
                 owner). Same monogram + AuthorColor + AuthorLabel shape as a reply head. --%>
            <span class="monogram" aria-hidden="true" style="--mono-h: ${AuthorColor.hue(author, personas)}">${AuthorLabel.monogram(author)}</span>
            <span class="reply__author thread__op-author">${AuthorLabel.display(author)}</span>
        @endif
        <h1 class="thread__title">${title}</h1>
        @if(edited)
            <span class="reply__edited" data-edited-marker>(edited)</span>
        @endif
    </div>
    @if(!body.isBlank())
        <%-- bodyHtml is the OP body rendered from markdown (MarkdownRenderer escapes raw HTML), so
             $unsafe{} is safe here. Gate on the raw body so an all-whitespace OP stays hidden. --%>
        <div class="thread__body" data-op-body>$unsafe{bodyHtml}</div>
    @endif
    <%-- Opening-post images. The OP is always owner-authored, so the Describe control is shown. --%>
    @template.fragments.attachments(attachments = attachments, owner = true)
    <%-- Edit the post: title + body. Save posts to /threads/{id}/edit and swaps this block in place;
         Cancel closes the disclosure with no request. A blank title is rejected server-side (the post
         keeps a title); the body may be emptied. --%>
    <details class="thread__op-edit reply__edit">
        <summary class="reply__edit-trigger">Edit post</summary>
        <form class="composer composer--inline reply__edit-form" data-edit-op="${threadId}"
              hx-post="/threads/${threadId}/edit"
              hx-target="#reply-${threadId}"
              hx-swap="outerHTML"
              hx-disabled-elt="find button[type='submit']">
            <%-- required: the server drops the WHOLE edit (body changes included) on a blank title —
                 let the browser catch it before submit instead of silently losing the user's edits. --%>
            <input type="text" name="title" class="thread__op-edit-title" value="${title}"
                   aria-label="Post title" required>
            <div class="composer__editor">
                <textarea name="text" class="reply__edit-text" data-edit-text
                          placeholder="Opening post (optional)">${body}</textarea>
            </div>
            <div class="composer__row">
                <span class="composer__hint">Edit the title and opening post.</span>
                <button type="button" class="btn btn--ghost"
                        onclick="this.closest('details').open = false">Cancel</button>
                <button class="btn" type="submit">Save ▸</button>
            </div>
        </form>
    </details>
</div>
